# TerraPanel 统一环境变量（本地开发与 Docker 部署共用）
# 复制为 .env 后按需修改：cp .env.example .env

# --- 应用 ---
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- 前端（Vite 构建/开发，仅 VITE_ 前缀会暴露到浏览器）---
VITE_API_BASE=/api

# --- Docker 构建 ---
# 构建阶段可用 Alpine（体积小）；运行阶段必须用 Debian（Terraria 需要 glibc）
# 国内网络拉 Docker Hub 超时时改用镜像源
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
RUNNER_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim

# --- Terraria 服务器 ---
TERRARIA_INSTALL_PATH=./data/terraria
TERRARIA_DATA_PATH=./data/terraria
TERRARIA_EXECUTABLE=TerrariaServer.bin.x86_64
# Linux 专用服务器压缩包下载地址（一键安装必需，版本需与客户端一致）
TERRARIA_DOWNLOAD_URL=

TERRARIA_SERVER_PORT=7777
TERRARIA_MAX_PLAYERS=8
TERRARIA_WORLD_PATH=
TERRARIA_WORLD_NAME=world
TERRARIA_WORLD_SIZE=2
TERRARIA_WORLD_SEED=
TERRARIA_WORLD_DIFFICULTY=0
TERRARIA_PASSWORD=
TERRARIA_MOTD=Welcome to TerraPanel Server
TERRARIA_AUTOSAVE_MINUTES=10
